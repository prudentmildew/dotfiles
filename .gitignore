/.idea/

# ~/.config is stowed file-by-file (stow --no-folding), so tools write their
# own state to the real ~/.config. Ignore anything else that lands here and
# opt tracked config back in explicitly.
/.config/*
!/.config/gh/
!/.config/git/
!/.config/starship.toml

# gh per-host account state
/.config/gh/hosts.yml
